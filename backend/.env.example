# Salin file ini menjadi .env (jangan hapus file ini, dan jangan commit .env):
#   PowerShell : Copy-Item .env.example .env
#   Git Bash   : cp .env.example .env
# Lalu sesuaikan nilai di bawah dengan komputer masing-masing.

NODE_ENV=development
PORT=3000
# 0.0.0.0 agar emulator Android (10.0.2.2) dan HP di jaringan yang sama bisa mengakses API.
HOST=0.0.0.0
# Alamat web (Vite) yang boleh memanggil API, dipisah koma.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MySQL lokal (Laragon/XAMPP). Buat database kosong dengan nama DB_NAME terlebih dahulu.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=db_ppsi
DB_USER=root
DB_PASSWORD=

# WAJIB diisi (minimal 32 karakter), kalau kosong login akan gagal dengan error 503.
# Buat dengan: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=

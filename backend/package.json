{
  "name": "sim-kesiswaan-api",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test",
    "db:check": "node src/database-check.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed:required": "node database/seed.js required",
    "db:seed:development": "node database/seed.js development",
    "test:integration": "node --test --test-concurrency=1 tests/admin.integration.js tests/lanjutan.integration.js",
    "badge:recalculate": "node src/recalculate-badges.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "sequelize": "^6.37.7",
    "mysql2": "^3.14.4"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.3"
  },
  "overrides": {
    "sequelize": {
      "uuid": "^11.1.1"
    }
  }
}
